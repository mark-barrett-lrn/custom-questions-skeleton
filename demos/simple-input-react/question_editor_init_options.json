{
  "question_type_groups": [
    {
      "name": "Custom Question Types",
      "reference": "custom_q_types"
    }
  ],
  "question_type_templates": {
    "custom_code_challenge": [
      {
        "name": "Custom Question - Code Challenge",
        "description": "A custom question type - Code Challenge",
        "group_reference": "custom_q_types",
        "defaults": {
          "stimulus": "<h2>Maximum Subarray</h2><br/><p>\n  Given an integer array <code>nums</code>, find the\n  <strong>subarray</strong> with the largest sum, and return <em>its sum</em>.\n</p>\n<br />\n<p><strong>Example 1:</strong></p>\n<pre><strong>Input:</strong> nums = [-2,1,-3,4,-1,2,1,-5,4]\n<strong>Output:</strong> 6\n<strong>Explanation:</strong> The subarray [4,-1,2,1] has the largest sum 6.\n</pre>\n",
          "type": "custom",
          "js": {
            "question": "/dist/question.js",
            "scorer": "/dist/scorer.js"
          },
          "css": "/dist/question.css",
          "test_cases": [
            {
              "input": {
                "nums": [-2, 1, -3, 4, -1, 2, 1, -5, 4]
              },
              "output": 6
            },
            {
              "input": {
                "nums": [1]
              },
              "output": 1
            },
            {
              "input": {
                "nums": [5, 4, -1, 7, 8]
              },
              "output": 23
            }
          ],
          "valid_response": {
            "value": [6, 1, 23],
            "score": 10
          },
          "instant_feedback": true
        }
      }
    ]
  },
  "custom_question_types": [
    {
      "custom_type": "custom_code_challenge",
      "type": "custom",
      "name": "Custom Code Challenge",
      "editor_layout": "/authoring_custom_layout.html",
      "js": {
        "question": "/dist/question.js",
        "scorer": "/dist/scorer.js"
      },
      "css": "/dist/question.css",
      "version": "v1.0.0",
      "editor_schema": {
        "hidden_question": false,
        "attributes": {
          "test_cases": {
            "description": "Test cases to validate student code against. It will be run against each of it",
            "name": "Test cases",
            "required": true,
            "type": "question",
            "default": [
              {
                "input": {
                  "nums": [-2, 1, -3, 4, -1, 2, 1, -5, 4]
                },
                "output": 6
              }
            ],
            "white_list": ["input", "output"],
            "editorV3": {
              "description": "Test cases to validate student code against. It will be run against each of it"
            }
          },
          "valid_response": {
            "name": "Set correct answer(s)",
            "description": "In this section, configure the correct answer(s) for the question.",
            "type": "object",
            "attributes": {
              "value": {
                "name": "Correct Answer",
                "required": true,
                "type": "string",
                "default": "",
                "editorV3": {
                  "element": "question",
                  "white_list": ["max_length"],
                  "description": ""
                }
              },
              "score": {
                "name": "Point(s)",
                "description": "Score awarded for the correct response(s).",
                "type": "number",
                "required": true,
                "default": 10
              }
            }
          },
          "instant_feedback": {
            "name": "Check answer button",
            "description": "Enables the Check Answer button underneath the question, which will provide the student with instant feedback on their response(s).",
            "type": "boolean",
            "required": false,
            "default": false
          }
        }
      }
    }
  ]
}
